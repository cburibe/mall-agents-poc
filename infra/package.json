{
  "name": "mall-agents-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura CDK (TypeScript) de la POC mall-agents",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth --quiet"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-python-alpha": "2.277.0-alpha.0",
    "aws-cdk-lib": "2.277.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/source-map-support": "0.5.10",
    "aws-cdk": "2.1148.1",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false
  }
}
